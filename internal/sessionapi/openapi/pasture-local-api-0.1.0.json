{
  "components": {
    "schemas": {
      "ActivityState": {
        "enum": [
          "active",
          "idle",
          "ended",
          "unknown"
        ],
        "type": "string"
      },
      "BindRequest": {
        "properties": {
          "epochId": {
            "type": "string"
          },
          "expectedBinding": {
            "type": "string"
          },
          "role": {
            "enum": [
              "epoch",
              "architect",
              "reviewer",
              "supervisor",
              "worker"
            ],
            "type": "string"
          }
        },
        "required": [
          "epochId",
          "role"
        ],
        "type": "object"
      },
      "Detail": {
        "properties": {
          "asOf": {
            "format": "date-time",
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          },
          "session": {
            "$ref": "#/components/schemas/SessionView"
          }
        },
        "required": [
          "revision",
          "asOf",
          "session"
        ],
        "type": "object"
      },
      "EndMarker": {
        "properties": {
          "endReason": {
            "$ref": "#/components/schemas/EndReason"
          },
          "endedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "endedAt",
          "endReason"
        ],
        "type": "object"
      },
      "EndReason": {
        "enum": [
          "unbind",
          "session_end"
        ],
        "type": "string"
      },
      "EpochRef": {
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Page": {
        "properties": {
          "asOf": {
            "format": "date-time",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionView"
            },
            "type": "array"
          },
          "next": {
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "asOf",
          "items"
        ],
        "type": "object"
      },
      "SessionActivity": {
        "properties": {
          "firstSeen": {
            "format": "date-time",
            "type": "string"
          },
          "lastEvent": {
            "type": "string"
          },
          "lastSeen": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ActivityState"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "SessionBinding": {
        "properties": {
          "bindingId": {
            "type": "string"
          },
          "boundAt": {
            "format": "date-time",
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "bindingId",
          "role",
          "boundAt"
        ],
        "type": "object"
      },
      "SessionView": {
        "properties": {
          "activity": {
            "$ref": "#/components/schemas/SessionActivity"
          },
          "binding": {
            "$ref": "#/components/schemas/SessionBinding"
          },
          "end": {
            "$ref": "#/components/schemas/EndMarker"
          },
          "epoch": {
            "$ref": "#/components/schemas/EpochRef"
          },
          "harness": {
            "type": "string"
          },
          "nativeSessionId": {
            "type": "string"
          }
        },
        "required": [
          "harness",
          "nativeSessionId",
          "activity"
        ],
        "type": "object"
      },
      "UnbindRequest": {
        "properties": {
          "expectedBinding": {
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Loopback-only read API for active harness sessions mapped to epoch bindings. Transcripts are not served by this API.",
    "title": "Pasture Local Session API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/sessions": {
      "get": {
        "operationId": "listSessions",
        "parameters": [
          {
            "description": "Filter by the latest binding epoch id",
            "in": "query",
            "name": "epoch",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by derived activity state",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "enum": [
                "active",
                "idle",
                "ended",
                "unknown"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filter by harness id",
            "in": "query",
            "name": "harness",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size (default 50, maximum 100)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque page token from a previous response",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid filter or page token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Non-loopback Host or Origin"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session store could not be read"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session cache is stale"
          }
        },
        "summary": "List sessions"
      }
    },
    "/api/v1/sessions/{harness}/{nativeSessionId}": {
      "get": {
        "operationId": "getSession",
        "parameters": [
          {
            "description": "Harness id",
            "in": "path",
            "name": "harness",
            "required": true,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "description": "Native session id",
            "in": "path",
            "name": "nativeSessionId",
            "required": true,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid session key"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Non-loopback Host or Origin"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Session not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session store could not be read"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session cache is stale"
          }
        },
        "summary": "Get one session"
      }
    },
    "/api/v1/sessions/{harness}/{nativeSessionId}/bind": {
      "post": {
        "operationId": "bindSession",
        "parameters": [
          {
            "description": "Harness id",
            "in": "path",
            "name": "harness",
            "required": true,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "description": "Native session id",
            "in": "path",
            "name": "nativeSessionId",
            "required": true,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BindRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid session key or body"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Non-loopback Host or Origin"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unknown epoch"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Binding conflict"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session store could not be written"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session cache is stale or writes are unavailable"
          }
        },
        "summary": "Bind a session to an epoch"
      }
    },
    "/api/v1/sessions/{harness}/{nativeSessionId}/unbind": {
      "post": {
        "operationId": "unbindSession",
        "parameters": [
          {
            "description": "Harness id",
            "in": "path",
            "name": "harness",
            "required": true,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "description": "Native session id",
            "in": "path",
            "name": "nativeSessionId",
            "required": true,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnbindRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid session key or body"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Non-loopback Host or Origin"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No open binding or binding conflict"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session store could not be written"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The session cache is stale or writes are unavailable"
          }
        },
        "summary": "Unbind a session from its epoch"
      }
    }
  }
}
