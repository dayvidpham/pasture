{
  "description": "Pasture lifecycle adapters and shared-worktree git discipline for the pinned Claude Code contract.",
  "hooks": {
    "FileChanged": [
      {
        "matcher": ".envrc|.env",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event FileChanged --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event PostCompact --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event PostToolBatch --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event PostToolUse --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event PostToolUseFailure --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat ${CLAUDE_PLUGIN_ROOT}/hooks/bd-prime.md 2\u003e\u00261"
          },
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event PreCompact --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-discipline.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event PreToolUse --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event SessionEnd --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat ${CLAUDE_PLUGIN_ROOT}/hooks/bd-prime.md 2\u003e\u00261"
          },
          {
            "type": "command",
            "command": "\"${PASTURE_BIN:-pasture}\" hook lifecycle --harness claude-code --event SessionStart --host-executable \"${CLAUDE_CODE_EXECPATH:-}\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
