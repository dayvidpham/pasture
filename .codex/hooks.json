{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh .codex/hooks/events/PreToolUse.sh",
            "timeout": 600,
            "statusMessage": "Consulting Pasture lifecycle state"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh .codex/hooks/events/SessionStart.sh",
            "timeout": 600,
            "statusMessage": "Consulting Pasture lifecycle state"
          }
        ]
      }
    ]
  }
}
